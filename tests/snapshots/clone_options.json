    ".vimrc": "set number\n",
    "untracked.txt": "already here\n"
  },
  "git": {
    "core.bare": "false",
    "core.worktree": "<TMP>/work",
    "head": "ffb5b448eb49f2ceef0b8a35330628e2a80b670c",
    "status": [],
    "status.showUntrackedFiles": "no",
    "tracked": [
      ".config/app/settings.ini",
      ".vimrc"
    ],
    "yadm.managed": "true"
  },
  "private_dir_modes": {},
  "steps": [
    {
      "args": [
        "run",
        "clone",
        "--bare",
        "--no-checkout",
        "-w",
        "{tmp}/work",
        "{tmp}/remote.git"
      ],
      "returncode": 0,
      "stderr": "Cloning into 'repo.git'...\ndone.\n",
      "stdout": ""
    },
    {
      "args": [
        "run",
        "status",
        "--short"
      ],
      "returncode": 0,
      "stderr": "",
      "stdout": " D .config/app/settings.ini\n D .vimrc\n"
    },
    {
      "args": [
        "run",
        "clone",
        "-f",
        "--no-bootstrap",
        "-b",
        "main",
        "{tmp}/remote.git"
      ],
      "returncode": 0,
      "stderr": "Cloning into 'repo.git'...\ndone.\n",
      "stdout": ""
    }
  ]
